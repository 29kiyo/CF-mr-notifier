# ===== 必須 =====
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 適当な長い文字列(32文字以上)
SESSION_SECRET=
# ダッシュボードのURL(複数ある場合はカンマ区切り。末尾の / は不要)
DASHBOARD_ORIGINS=https://example.lovable.app

# ===== 任意(なくても動くが機能が制限される) =====
# CurseForge通知に必要
CURSEFORGE_API_KEY=
# GitHub監視に推奨(なしだと1時間60回までの制限)
GITHUB_TOKEN=
# RenderのURL(Renderでは自動設定されるので通常は不要)
PUBLIC_URL=
# チェック間隔(分)
POLL_MINUTES=5
PORT=3000
